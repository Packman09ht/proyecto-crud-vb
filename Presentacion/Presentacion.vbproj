<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>AcademiaIdiomas</RootNamespace>
    <MyType>Empty</MyType>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionInfer>On</OptionInfer>
    <AssemblyName>AcademiaIdiomas</AssemblyName>
    <StartupObject>AcademiaIdiomas.Program</StartupObject>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <ItemGroup>
    <Import Include="System.Windows.Forms" />
    <Import Include="System.Drawing" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Configuration" />
    <Reference Include="System.Data" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Entidades\Entidades.vbproj" />
    <ProjectReference Include="..\AccesoDatos\AccesoDatos.vbproj" />
    <ProjectReference Include="..\LogicaNegocio\LogicaNegocio.vbproj" />
  </ItemGroup>
</Project>
